---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME } from '../config';
---

<Layout title={`Page not found | ${SITE_NAME}`} description="This page does not exist.">
  <div class="max-w-2xl">
    <h1 class="text-4xl font-extrabold">That page does not exist</h1>
    <p class="mt-4 text-lg text-muted">
      The link may be old or mistyped. The image tools are on the
      <a class="underline" href="/">home page</a>.
    </p>
  </div>
</Layout>
